{
  "info": {
    "name": "Banking API Assessment",
    "description": "Grader collection for the Node.js banking API take-home.\n\nRun against a candidate (or reference) server at {{baseUrl}} after `npm run setup && npm start`.\n\nCore folder = junior bar. Stretch folder = mid/senior.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "customerId",
      "value": "cust_001"
    },
    {
      "key": "accountId",
      "value": "acct_001"
    },
    {
      "key": "createdCustomerId",
      "value": ""
    },
    {
      "key": "createdAccountId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Docs",
      "item": [
        {
          "name": "Swagger UI",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/docs"
          }
        },
        {
          "name": "OpenAPI YAML",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/openapi.yaml"
          }
        }
      ]
    },
    {
      "name": "Core",
      "item": [
        {
          "name": "Get seeded customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('has customerId', () => pm.expect(body.customerId).to.eql('cust_001'));",
                  "pm.test('has email', () => pm.expect(body.email).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/customers/{{customerId}}"
          }
        },
        {
          "name": "Get missing customer → 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 404', () => pm.response.to.have.status(404));",
                  "const body = pm.response.json();",
                  "pm.test('error shape', () => {",
                  "  pm.expect(body).to.have.property('error');",
                  "  pm.expect(body).to.have.property('message');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/customers/does_not_exist"
          }
        },
        {
          "name": "Create customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('returns customerId', () => pm.expect(body.customerId).to.be.a('string'));",
                  "pm.collectionVariables.set('createdCustomerId', body.customerId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Grace Hopper\",\n  \"email\": \"grace@example.com\"\n}"
            },
            "url": "{{baseUrl}}/customers"
          }
        },
        {
          "name": "Create customer missing email → 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"No Email\"\n}"
            },
            "url": "{{baseUrl}}/customers"
          }
        },
        {
          "name": "Create account for customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('has balance', () => pm.expect(body.balance).to.be.a('number'));",
                  "pm.collectionVariables.set('createdAccountId', body.accountId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"CHECKING\",\n  \"currency\": \"CAD\",\n  \"initialBalance\": 40\n}"
            },
            "url": "{{baseUrl}}/customers/{{customerId}}/accounts"
          }
        },
        {
          "name": "List accounts for customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('items array', () => pm.expect(body.items).to.be.an('array'));",
                  "pm.test('seeded accounts present', () => pm.expect(body.items.length).to.be.at.least(2));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/customers/{{customerId}}/accounts"
          }
        },
        {
          "name": "Get account with balance",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('accountId', () => pm.expect(body.accountId).to.eql('acct_001'));",
                  "pm.test('balance number', () => pm.expect(body.balance).to.be.a('number'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/accounts/{{accountId}}"
          }
        }
      ]
    },
    {
      "name": "Stretch",
      "item": [
        {
          "name": "Deposit",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('balance increased or present', () => pm.expect(body.balance).to.be.a('number'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 10,\n  \"currency\": \"CAD\"\n}"
            },
            "url": "{{baseUrl}}/accounts/{{accountId}}/deposits"
          }
        },
        {
          "name": "Withdraw",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 5,\n  \"currency\": \"CAD\"\n}"
            },
            "url": "{{baseUrl}}/accounts/{{accountId}}/withdrawals"
          }
        },
        {
          "name": "Withdraw insufficient funds → 409",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 409', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 999999,\n  \"currency\": \"CAD\"\n}"
            },
            "url": "{{baseUrl}}/accounts/{{accountId}}/withdrawals"
          }
        },
        {
          "name": "Transfer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('fromAccount', () => pm.expect(body.fromAccount).to.be.an('object'));",
                  "pm.test('toAccount', () => pm.expect(body.toAccount).to.be.an('object'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromAccountId\": \"acct_001\",\n  \"toAccountId\": \"acct_002\",\n  \"amount\": 1,\n  \"currency\": \"CAD\"\n}"
            },
            "url": "{{baseUrl}}/transfers"
          }
        }
      ]
    }
  ]
}
